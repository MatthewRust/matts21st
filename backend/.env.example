NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://matts21st:devpassword@localhost:5432/matts21st

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset the server generates a random secret per process, which is safe but
# logs everyone out on every restart or redeploy. Set it in production.
AUTH_SECRET=

# Image storage (Cloudinary). This file is a committed TEMPLATE — put real
# values in backend/.env (gitignored), never here.
# Leave these blank to store uploads on local disk under backend/uploads/ —
# fine for development, but container-local, so they must be set in production
# or the gallery disappears on the next redeploy.
# Copy the values from the Cloudinary dashboard (Settings -> API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: root folder inside the Cloudinary media library (default matts21st)
CLOUDINARY_FOLDER=matts21st
